<link rel="stylesheet" href="/stylesheets/index.css">

<!-- search bar -->
<div class="container search-bar">
  <div class="search-bar-outer">
    <div class="search-bar-inner">
      <form action="/search">
        <h4 class="mb-2">尋找餐廳：</h4>
        <div class="input-group">
          <input type="text" name="keyword" class="form-control" placeholder="輸入餐廳、分類" aria-label="Restaurant Name..."
            value="" aria-describedby="search-button">
          <div class="input-group-append">
            <button class="btn btn-major" type="submit" id="search-button"><i class="fas fa-search"></i></button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>




<!-- restaurant list -->
<div class="container mt-5">
  <div class="row">
    <div class="col-md-10 col-12 mx-auto">
      <!-- sort -->
      <div class="row justify-content-end">
        <div class="col-3">
          <select class="form-select" aria-label="Default select example">
            <option selected>排序</option>
            <option value="1">A->Z</option>
            <option value="2">Z->A</option>
            <option value="3">類別</option>
            <option value="3">地區</option>
          </select>
        </div>
      </div>
      <div class="row row-cols-sm-3 mt-2 gy-5">
        {{#each restaurants}}
        <div class="col">
          <div class="row">
            <a href="/restaurants/{{this.id}}" class="text-secondary">
              <div class="card mb-3">
                <img class="card-img-top" src="{{this.image}}" alt="{{this.name}}">
                <div class="card-body p-3">
                  <h6 class="card-title mb-1">{{this.name}}</h6>
            
                  <div class="restaurant-category mb-1">
                    <i class="fas fa-utensils pr-2"></i> {{this.category}}
                  </div>
            
                  <span class="badge rounded-pill bg-danger font-weight-normal">
                    {{this.rating}}
                    <i class="fas fa-star fa-xs"></i>
                  </span>
            
                </div>
              </div>
            </a>
          </div>
          <div class="row mb-3">
            <div class="col d-flex justify-content-end align-content-center">
              <a href="/restaurants/{{this.id}}/edit" class="mx-2 p-1" style="line-height: initial;">Edit</a>
              <a href="/restaurants/{{this.id}}" class="mx-2 p-1" style="line-height: initial;">Detail</a>
              <form action="/restaurants/{{this.id}}?_method=DELETE" method="POST">
                <button type="submit">Delete</button>
              </form>
            </div>
          </div>
        </div>
        {{/each}}
          

      </div>
    </div>
  </div>
</div>