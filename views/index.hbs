<link rel="stylesheet" href="/stylesheets/index.css">

{{>navbar}}

<div class="container search-bar">
  <div class="search-bar-outer">
    <div class="search-bar-inner">
      <form action="/restaurants/search" method="GET">
        <!-- search bar -->
        
        <div class="row mb-3">
          <div class="col-6">
            <h4 class="mb-2 fw-bold mb-3">尋找餐廳：</h4>
          </div>
          <div class="col-6 d-flex justify-content-end p">
            <a href="/restaurants/new" class="fw-bold"><i class="fa-solid fa-circle-plus"></i> 新增餐廳</a>
          </div>
        </div>
        <div class="row">
          <div class="col-12 col-sm-8 mb-3">
            <div class="input-group">
              <input type="text" name="keyword" class="form-control fs-6" placeholder="輸入餐廳、分類" aria-label="Restaurant Name..."
                value="{{#if keyword}} {{keyword}} {{/if}}" aria-describedby="search-button">
              <div class="input-group-append">
                <button class="btn btn-major" type="submit" id="search-button"><i class="fas fa-search"></i></button>
              </div>
            </div>
          </div>
          <!-- sort -->
          <div class="col-12 col-sm-4"> 
            <select class="form-select fw-bold" aria-label="Default select example" id="sort">
              <option selected>排序方法</option>
              <option value="1">A->Z</option>
              <option value="2">Z->A</option>
              <option value="3">類別</option>
              <option value="3">地區</option>
            </select>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- restaurant list -->
<div class="container my-5">
  <div class="row">
    <div class="col-md-10 col-12 mx-auto">
      <div class="row row-cols-sm-3 mt-2 gy-5">
        {{#each restaurants}}
        <div class="col">
          <div class="row gx-1">
            <a href="/restaurants/{{this.id}}" class="text-secondary">
              <div class="card p-0">
                <img class="card-img-top" src="{{this.image}}" alt="{{this.name}}">
                <div class="card-body p-3">
                  <h6 class="card-title mb-1">{{this.name}}</h6>
            
                  <div class="restaurant-category mb-1">
                    <i class="fas fa-utensils pr-2"></i> {{this.category}}
                  </div>
            
                  <span class="badge rounded-pill bg-danger font-weight-normal">
                    {{this.rating}}
                    <i class="fas fa-star fa-xs"></i>
                  </span>
                </div>
                <div class="card-body d-flex justify-content-end align-content-center p-3">
                  <a href="/restaurants/{{this.id}}/edit" class="btn btn-primary me-2 fw-bold">
                    <i class="fa-solid fa-pen-to-square"></i>編輯
                  </a>
                  <a href="/restaurants/{{this.id}}" class="btn btn-success me-2 fw-bold">
                    <i class="fa-solid fa-circle-info"></i>詳細
                  </a>
                  <form action="/restaurants/{{this.id}}?_method=DELETE" method="POST">
                    <button class="btn btn-danger" type="submit"><i class="fa-solid fa-trash-can"></i></button>
                  </form>
                </div>
              </div>
            </a>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>

<!-- message -->
{{>message}}